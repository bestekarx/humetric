{
  "mcpServers": {
    "humetric": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/bestekarx/humetric.git",
        "humetric-mcp"
      ],
      "env": {
        "HUMETRIC_MCP_API_KEY": "hm_live_your_api_key_here",
        "HUMETRIC_BASE_URL": "http://localhost:8002"
      }
    }
  }
}
